; Minimal Atari 2600 register definitions used by A26F NEO.

VSYNC   = $00
VBLANK  = $01
WSYNC   = $02
COLUPF  = $08
COLUBK  = $09
CTRLPF  = $0A
PF0     = $0D
PF1     = $0E
PF2     = $0F

AUDC0   = $15
AUDC1   = $16
AUDF0   = $17
AUDF1   = $18
AUDV0   = $19
AUDV1   = $1A

INPT4   = $0C
INPT5   = $0D

SWCHA   = $0280
SWACNT  = $0281
TIMINT  = $0285
TIM64T  = $0296
T1024T  = $0297
